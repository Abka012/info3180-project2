VITE_API_BASE_URL=https://your-backend-service.onrender.com

# Frontend URL for email links
FRONTEND_URL=https://your-frontend-service.onrender.com

# Email Configuration (Production)
# ===== RESEND CONFIGURATION =====
# Render free services can block SMTP ports. Use Resend for reliable delivery.
# IMPORTANT: EMAIL_FROM must be a VERIFIED sender in Resend dashboard!
# Go to https://resend.com/domains to verify your domain
# Or use Resend's default sender: "DriftDater <onboarding@resend.dev>" (for testing only)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789  # Get from https://resend.com/api-keys

# Sender email address - MUST be verified in Resend dashboard
# Options:
# 1. Use Resend's test sender: "DriftDater <onboarding@resend.dev>" (rate limited)
# 2. Use your own verified domain: "DriftDater <noreply@yourdomain.com>"
EMAIL_FROM="DriftDater <onboarding@resend.dev>"

# Resend API URL (usually no need to change)
RESEND_API_URL=https://api.resend.com/emails

# If you want fallback to SMTP when Resend fails:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL="DriftDater <your_email@gmail.com>"
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
